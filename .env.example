# Copy this file to .env.local for local work. On Vercel, add the same two
# variables under Project -> Settings -> Environment Variables.
#
# Both values are in Supabase: Project Settings -> API.
# The anon key is meant to be public. Row Level Security (supabase/schema.sql)
# is what keeps everyone except you from writing.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Optional: show hidden TODO placeholders on the homepage while editing.
# NEXT_PUBLIC_SHOW_TODOS=1
